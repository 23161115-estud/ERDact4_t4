meta {
  name: 01 Registro
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Emiliano Ruiz Durán",
    "correo": "{{correo}}",
    "password": "Secreto123"
  }
}

script:pre-request {
  // Correo distinto en cada ejecución para poder repetir la prueba
  bru.setEnvVar("correo", "emiliano" + Date.now() + "@escuela.mx");
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("token", res.body.token);
  }
}

assert {
  res.status: eq 201
  res.body.token: isString
  res.body.usuario.password: isUndefined
}

docs {
  Crea un usuario nuevo y devuelve un JWT. La respuesta NUNCA incluye el password.
}
