meta {
  name: 02 Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "correo": "{{correo}}",
    "password": "Secreto123"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.token);
  }
}

assert {
  res.status: eq 200
  res.body.token: isString
  res.body.tipo: eq Bearer
}

docs {
  Inicia sesión con el usuario del paso 01 y guarda el token en la variable `token`.
}
